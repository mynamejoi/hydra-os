#!/bin/sh
# hydra-setup: Hydra-OS's setup, run by Claude in the person's own chat after they said yes, by its full path in the
# plugin Claude installed:
#
#   hydra-setup --claude <the Claude Code running this chat> --helpers yes|no
#
# --claude is the Claude Code this chat runs on, the one that installed the plugin. Setup uses it for Claude Code's own
# plugin commands, since a Mac with the Claude app alone has no claude command of its own, and it never looks for one
# anywhere else. --helpers is the person's own answer to whether Hydra-OS's two helpers, Home's server and the tick,
# start at login, which Claude asks before setup. Without either, nothing changes, and it says what's needed.
#
# Hydra-OS runs on Apple's own python3, from Apple's free developer tools, which Claude Code's own start-up check
# already asks a Mac to install. This checks they're there (xcode-select -p, and a python3 that starts). When they
# aren't, it opens Apple's own installer (xcode-select --install), says so in one line, and changes nothing else.
# Nothing is downloaded here. Then it runs setup, scripts/install.py, on /usr/bin/python3. It exits 0 once Hydra-OS is
# set up, or 2 with a line on what stopped it.
#
# For tests only: HYDRA_TEST_PYTHON names another python3, and HYDRA_TEST_NO_DEVTOOLS=1 stands for a Mac without the
# developer tools. Under any HYDRA_TEST_ switch, Apple's installer is never opened (HYDRA_TEST_OPENED notes it).
set -u
umask 077
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

say() { printf '%s\n' "$*"; }
stop() {  # its one line, then the line on what to do next
  say "$*"
  say "Setup didn't finish, and nothing was changed. Run this same hydra-setup again to pick up from here."
  exit 2
}

claude=""
helpers=""
while [ $# -gt 0 ]; do
  case "$1" in
    --claude|--helpers)
      [ $# -ge 2 ] || stop "hydra-setup takes --claude <the Claude Code running this chat> and --helpers yes or no."
      [ "$1" = --claude ] && claude=$2
      [ "$1" = --helpers ] && helpers=$2
      shift 2 ;;
    *) stop "hydra-setup takes --claude <the Claude Code running this chat> and --helpers yes or no." ;;
  esac
done
case "$helpers" in
  yes|no) ;;
  *) say "Before setup, ask them whether Hydra-OS's two helpers may start each time they log in to this Mac: Home's server, which shows their pages, and the tick, which starts each page's daily read every 15 minutes. With a no, nothing runs while no Hydra-OS chat is open. Then run this same hydra-setup with --helpers yes or --helpers no."
     exit 2 ;;
esac
case "$claude" in
  /*/claude) [ -f "$claude" ] && [ -x "$claude" ] || claude="" ;;
  *) claude="" ;;
esac
[ -n "$claude" ] || stop "hydra-setup needs --claude with the full path of the Claude Code running this chat, the one that installed this plugin."

here=$(cd "$(dirname "$0")/.." 2>/dev/null && pwd -P) || stop "Hydra-OS's setup can't find its own files."
[ -f "$here/scripts/install.py" ] || stop "Hydra-OS's setup can't find its own files."
root="$HOME/Hydra-OS"
testing=no
/usr/bin/env | /usr/bin/grep -q '^HYDRA_TEST_' && testing=yes
py=${HYDRA_TEST_PYTHON:-/usr/bin/python3}

# Apple's developer tools first: xcode-select -p before python3, since on a Mac without them /usr/bin/python3 itself
# would ask to install them
tools=yes
if [ -n "${HYDRA_TEST_NO_DEVTOOLS:-}" ] || ! /usr/bin/xcode-select -p >/dev/null 2>&1; then
  tools=no
elif ! "$py" -I -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1; then
  tools=no
fi
if [ "$tools" = no ]; then
  if [ "$testing" = yes ]; then
    [ -n "${HYDRA_TEST_OPENED:-}" ] && printf '%s\n' "xcode-select --install" >> "$HYDRA_TEST_OPENED"
  else
    /usr/bin/xcode-select --install >/dev/null 2>&1
  fi
  say "Hydra-OS runs on Apple's free developer tools, and they aren't on this Mac yet. Apple's installer is open now. Once it's done, run this same hydra-setup again."
  exit 2
fi

# setup's own lines, kept and then said whole, so an end with none is known: Python ends 2 with its words on stderr
# alone when it can't open a file
jobs=""
[ "$helpers" = yes ] && jobs="--jobs"
said=$(/usr/bin/mktemp -t hydra-setup) || stop "Hydra-OS's setup couldn't start on this Mac."
HYDRA_CLAUDE=$claude "$py" -I -B "$here/scripts/install.py" $jobs --root "$root" --python "$py" > "$said"
code=$?
/bin/cat "$said"
spoke=no
[ -s "$said" ] && spoke=yes
/bin/rm -f "$said"
if [ "$code" -ne 0 ]; then
  [ "$code" -eq 2 ] && [ "$spoke" = yes ] && exit 2  # setup said its own lines
  stop "Hydra-OS's setup stopped on something it didn't expect."
fi
exit 0
