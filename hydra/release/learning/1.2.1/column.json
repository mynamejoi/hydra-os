{
 "contract": "column/v1",
 "id": "learning",
 "title": "Research",
 "kind": "engine",
 "what": "A weekly scout for what you're working on: what's new, what you're missing, how to sell it",
 "accent": 300,
 "icon": "scope",
 "home": {"size": "medium", "line": "A weekly scout for what you're working on.", "needs": "", "via": ""},
 "tips": [
  {"id": "finds", "block": "week", "text": "Your finds land here each Monday. Source shows where each one came from.",
   "when": "data"},
  {"id": "projects", "block": "projects", "text": "Your goals and projects each get a row. A cell fills in when the scout finds an answer.",
   "when": "data"},
  {"id": "current", "block": "projects", "at": "field", "text": "Add another project here, or tell Claude about one.",
   "when": "data"}
 ],
 "shape": {"name": "notes", "version": 1, "fields": {"title": "text", "day": "date", "topics": "text"}},
 "sources": [
  {"id": "notes", "kind": "upload", "name": "Your notes", "folder": "inbox/", "accepts": ["md", "txt"],
   "what": "your own notes, as plain text", "suggested": false, "source": "Your notes",
   "reads": "the notes you drop on Research's page, kept on this Mac", "filed": "Got it. Research keeps your note on this Mac."},
  {"id": "claude-code", "kind": "api", "name": "Claude Code's release notes", "service": "Claude Code's release notes",
   "client": "scripts/release.py", "site": "https://raw.githubusercontent.com", "reads": "what changed, from a public page",
   "suggested": true},
  {"id": "claude-api", "kind": "api", "name": "The Claude API's release notes", "service": "The Claude API's release notes",
   "client": "scripts/release.py", "site": "https://platform.claude.com", "reads": "what changed, from a public page",
   "suggested": true},
  {"id": "claude-apps", "kind": "api", "name": "The Claude app's release notes", "service": "The Claude app's release notes",
   "client": "scripts/release.py", "site": "https://support.claude.com", "reads": "what changed, from a public page",
   "suggested": true},
  {"id": "plugins", "kind": "api", "name": "The official plugin marketplace", "service": "The official plugin marketplace",
   "client": "scripts/release.py", "site": "https://raw.githubusercontent.com", "reads": "new plugins, from a public list",
   "suggested": true}
 ],
 "offers": [{"name": "angles", "version": 1, "file": "shared/angles.json",
             "what": "the last four weeks' finds worth a video, in general words, each with its source"}],
 "uses": [],
 "fits": null,
 "schedule": {"at": "07:40", "days": "daily", "run": ["scripts/run.py", "--trigger", "schedule"], "needs_claude": false},
 "think": {"input": ["scripts/think.py", "--input"], "save": ["scripts/think.py", "--save"], "search": "scripts/search.json"},
 "servers_needed": [],
 "doctor_lines": ["store"],
 "proofs": [],
 "guard": "search: shipped words only",
 "owner_only": [],
 "fresh_within": 26,
 "week_states": ["quiet", "steady", "busy"],
 "signals_in": [],
 "signals_out": [],
 "headless": [],
 "actions": [
  {"name": "add-project", "script": ["scripts/act.py", "add-project"], "confirm": "undo", "undo": "unadd-project",
   "writes": ["store/projects.json"], "fields": {"words": {"kind": "words", "max": 60}}},
  {"name": "unadd-project", "script": ["scripts/act.py", "unadd-project"], "confirm": "once",
   "writes": ["store/projects.json"], "fields": {"project": {"kind": "id", "list": ["scripts/act.py", "projects"]}}},
  {"name": "set-topic", "script": ["scripts/act.py", "set-topic"], "confirm": "undo", "undo": "unset-topic",
   "writes": ["store/projects.json", "store/goals.json"],
   "fields": {"project": {"kind": "id", "list": ["scripts/act.py", "scouted"]},
              "topic": {"kind": "id", "list": ["scripts/act.py", "topics"]}}},
  {"name": "unset-topic", "script": ["scripts/act.py", "unset-topic"], "confirm": "once",
   "writes": ["store/projects.json", "store/goals.json"],
   "fields": {"project": {"kind": "id", "list": ["scripts/act.py", "scouted"]},
              "topic": {"kind": "id", "list": ["scripts/act.py", "was"]}}},
  {"name": "skip-goal", "script": ["scripts/act.py", "skip-goal"], "confirm": "undo", "undo": "unskip-goal",
   "writes": ["store/goals.json"], "fields": {"goal": {"kind": "id", "list": ["scripts/act.py", "goals"]}}},
  {"name": "unskip-goal", "script": ["scripts/act.py", "unskip-goal"], "confirm": "once",
   "writes": ["store/goals.json"], "fields": {"goal": {"kind": "id", "list": ["scripts/act.py", "skipped"]}}}
 ]
}
