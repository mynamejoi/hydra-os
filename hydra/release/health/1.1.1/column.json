  {
   "name": "answer",
   "script": [
    "scripts/act.py",
    "answer"
   ],
   "confirm": "undo",
   "undo": "unanswer",
   "writes": [
    "answers.jsonl"
   ],
   "fields": {
    "question": {
     "kind": "id",
     "list": [
      "scripts/act.py",
      "questions"
     ]
    },
    "pick": {
     "kind": "id",
     "list": [
      "scripts/act.py",
      "picks"
     ],
     "of": "question",
     "optional": true
    },
    "on": {
     "kind": "choice",
     "of": [
      "yes",
      "no"
     ],
     "optional": true
    },
    "words": {
     "kind": "words",
     "max": 120,
     "optional": true
    }
   }
  },
  {
   "name": "unanswer",
   "script": [
    "scripts/act.py",
    "unanswer"
   ],
   "confirm": "once",
   "writes": [
    "answers.jsonl"
   ],
   "fields": {
    "question": {
     "kind": "id",
     "list": [
      "scripts/act.py",
      "questions"
     ]
    },
    "pick": {
     "kind": "id",
     "list": [
      "scripts/act.py",
      "picks"
     ],
     "of": "question",
     "optional": true
    }
   }
  },
  {
   "name": "log-meal",
   "script": [
    "scripts/act.py",
    "log-meal"
   ],
   "confirm": "undo",
   "undo": "unlog-meal",
   "writes": [
    "store/meals.jsonl"
   ],
   "fields": {
    "words": {
     "kind": "words",
     "max": 120
    }
   }
  },
  {
   "name": "unlog-meal",
   "script": [
    "scripts/act.py",
    "unlog-meal"
   ],
   "confirm": "once",
   "writes": [
    "store/meals.jsonl"
   ],
   "fields": {
    "meal": {
     "kind": "id",
     "list": [
      "scripts/act.py",
      "meals"
     ]
    }
   }
  },
  {
   "name": "log-workout",
   "script": [
    "scripts/act.py",
    "log-workout"
   ],
   "confirm": "undo",
   "undo": "unlog-workout",
   "writes": [
    "store/workouts.jsonl"
   ],
   "fields": {
    "kind": {
     "kind": "choice",
     "of": [
      "walk",
      "run",
      "ride",
      "swim",
      "lift",
      "yoga",
      "row"
     ]
    },
    "day": {
     "kind": "date",
     "from": -30,
     "to": 0
    },
    "minutes": {
     "kind": "number",
     "min": 1,
     "max": 600,
     "step": 1,
     "optional": true
    }
   }
  },
  {
   "name": "unlog-workout",
   "script": [
    "scripts/act.py",
    "unlog-workout"
   ],
   "confirm": "once",
   "writes": [
    "store/workouts.jsonl"
   ],
   "fields": {
    "workout": {
     "kind": "id",
     "list": [
      "scripts/act.py",
      "workouts"
     ]
    }
   }
  },
  {
   "name": "export-step",
   "script": [
    "scripts/act.py",
    "export-step"
   ],
   "confirm": "undo",
   "undo": "export-unstep",
   "writes": [
    "store/steps.json"
   ],
   "fields": {
    "step": {
     "kind": "number",
     "min": 1,
     "max": 3,
     "step": 1
    }
   }
  },
  {
   "name": "export-unstep",
   "script": [
    "scripts/act.py",
    "export-unstep"
   ],
   "confirm": "once",
   "writes": [
    "store/steps.json"
   ],
   "fields": {
    "step": {
     "kind": "number",
     "min": 0,
     "max": 3,
     "step": 1
    }
   }
  }
 ],
 "fits": {
  "units": [
   "swims",
   "runs",
   "rides",
   "walks",
   "lifts",
   "yogas",
   "rows",
   "workouts",
   "nights"
  ],
  "script": "scripts/goals.py",
  "what": "swims, runs, rides, walks, workouts and nights of sleep from your iPhone's Health data"
 }
}
