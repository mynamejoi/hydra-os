{
 "contract": "column/v1",
 "id": "health",
 "title": "Wellbeing",
 "kind": "engine",
 "what": "Sleep, heart rate and what's moving them, from your Apple Health export or a file of days",
 "accent": 159,
 "icon": "heart",
 "home": {
  "size": "large",
  "line": "Sleep, heart rate and what's moving them.",
  "needs": "Add your Health data",
  "via": "About ten minutes with your iPhone."
 },
 "tips": [
  {
   "id": "health-drop",
   "block": "today",
   "at": "drop",
   "text": "Drop your Health export here. Your sleep shows in a few minutes.",
   "when": "first-visit"
  }
 ],
 "shape": {
  "name": "days",
  "version": 1,
  "fields": {
   "day": "date",
   "readiness": "number",
   "readiness_name": "word",
   "sleep_hours": "number",
   "resting_heart": "number",
   "lights_out": "word",
   "woke": "word",
   "sports": "text",
   "weight": "number",
   "hrv": "number"
  }
 },
 "sources": [
  {
   "id": "upload",
   "kind": "upload",
   "name": "Apple Health",
   "folder": "inbox/",
   "accepts": [
    "zip",
    "xml",
    "csv",
    "json"
   ],
   "what": "your Apple Health export, or a file of days",
   "suggested": false,
   "source": "Apple Health",
   "reads": "sleep, resting heart and workouts",
   "filed": "Got it. Wellbeing is reading your export now."
  }
 ],
 "offers": [
  {
   "name": "day",
   "version": 1,
   "file": "shared/day.json",
   "what": "tonight's lights out and when you woke"
  }
 ],
 "uses": [],
 "schedule": {
  "at": "07:40",
  "days": "daily",
  "run": [
   "scripts/run.py",
   "--trigger",
   "schedule"
  ],
  "needs_claude": false
 },
 "think": {
  "input": [
   "scripts/think.py",
   "--input"
  ],
  "save": [
   "scripts/think.py",
   "--save"
  ]
 },
 "headless": [],
 "servers_needed": [],
 "signals_in": [],
 "signals_out": [],
 "doctor_lines": [],
 "proofs": [],
 "guard": null,
 "owner_only": [],
